{
  // Project configuration files use JSONC: they may contain comments and
  // trailing commas, matching how JsonConfigLoader parses them
  // (JsonCommentHandling.Skip, AllowTrailingCommas).
  //
  // Without this association, VS Code reports "Comments are not permitted in JSON"
  // on every comment line, cluttering real diagnostics.
  "files.associations": {
    "**/src/projects/**/*.json": "jsonc",
    "**/config/**/*.json": "jsonc"
  }
}
