<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PicoGK" Version="2.3.0" />
  </ItemGroup>

  <!--
    Die Projekte liegen bewusst NEBEN dem Framework unter src/projects/ und nicht darin:
    "hier das Geruest, dort meine Projekte" ist fuer einen fremden Nutzer sofort lesbar.
    Preis dafuer ist diese eine Zeile (TODO-24).

    Der Include zeigt nach "..", also ausserhalb des SDK-Globs dieser csproj. Es gibt
    deshalb keine Doppelung. Wuerde src/projects je unter die csproj wandern, muss die
    Zeile weg.

    Die JSON-Dateien der Projekte werden bewusst NICHT mitkopiert: sie laegen dann in bin/,
    und eine Aenderung an der Quelldatei wuerde erst nach einem Rebuild wirken. Diese Sorte
    Verwirrung will man bei einem mehrstuendigen Lauf nicht.
  -->
  <ItemGroup>
    <Compile Include="..\projects\**\*.cs" Exclude="..\projects\**\bin\**;..\projects\**\obj\**" />
  </ItemGroup>

</Project>
