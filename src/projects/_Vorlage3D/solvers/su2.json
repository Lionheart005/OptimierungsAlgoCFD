{
  // MeinProjekt -- SU2-Solver. Was jeder Schluessel bewirkt: src/projects/BEDIENHANDBUCH.md
  //
  // Diese Datei nennt jeden Schluessel mit seinem Code-Standard (Solvers/Cfd/Su2SolverOptions.cs).
  // In einem echten Projekt bleibt nur stehen, was abweicht. Ein unbekannter Schluessel bricht den
  // Start ab, ausser innerhalb von "ResultMetrics". Rechnerspezifisches gehoert in su2.local.json.
  // Nicht hier, sondern in ../simulation.json: Su2MaxIterations, Cauchy-Werte, MpiCores, Programmpfade.

  // --- Fluid (Standard Meerwasser; Luft: 1.225 kg/m3 und 1.81e-5 Pa*s) ---
  "Density": 1025.0,            // kg/m3
  "DynamicViscosity": 0.001001, // Pa*s
  "TurbulenceModel": "SA",      // SA oder SST
  "SpeedOfSound": 343.2,        // m/s, Luftwert; nur fuer den Mach-Weg unten

  // Anstroemgeschwindigkeit in m/s (2.0 = uebliche AUV-Reisegeschwindigkeit).
  // 0 = MachNumber x SpeedOfSound; das waere in Wasser unrealistisch (34 m/s).
  "FreestreamVelocity": 2.0,

  // --- Dimension, Anstellwinkel, Referenzwerte ---
  "Dimensions": 3,
  "AngleOfAttackDeg": 0.0,
  "ReferenceLength": 0.01,
  // Name einer Metrik des Geometrie-Generators (AddMetric, in mm2), aus der SU2 die Bezugsflaeche bildet.
  "ReferenceAreaMetric": "FrontalArea",

  // --- Ergebnisgroessen ---
  // Links: Name, unter dem die Fitness-Formel den Wert liest. Rechts: Spalte der SU2-history.csv
  // (verfuegbar: CD, CL, CSF, CMx, CMy, CMz). Stolpersteine:
  //  - Eintraege werden zum Code-Standard hinzugefuegt, nicht ersetzt; "Drag" bleibt immer.
  //  - Eine konfigurierte, aber fehlende Spalte ist ein Fehler (Variante gilt als fehlgeschlagen).
  //  - Die Bezugsflaeche normiert alle Beiwerte; fuer Auftrieb passt oft eine Fluegelflaeche besser.
  "ResultMetrics": {
    "Drag": "CD"
  },

  // Groesse, an der SU2 die Konvergenz misst (bei Auftriebsoptimierung "LIFT").
  "ConvergenceField": "DRAG",
  "HistoryOutput": [ "ITER", "RMS_RES", "AERO_COEFF" ],

  // --- Konvergenzbewertung ---
  // Echte Drift im Endfenster = fehlgeschlagen; reines Schwingen (Wirbelabloesung) bleibt gueltig.
  // TailMean = Mittel des Endfensters statt Endwert; OscillationWarnLimit ist nur eine Warnschwelle.
  // AutoRestartOnDrift setzt bei fruehem Cauchy-Stopp mit Rest-Drift automatisch per RESTART_SOL fort.
  "OscillationWarnLimit": 0.05,
  "TreatUnconvergedAsFailed": true,
  "AutoRestartOnDrift": true,
  "MaxConvergenceRestarts": 3,
  "ResultAveraging": "TailMean",

  // --- CFL (divergiert SU2, zuerst CflNumber halbieren) ---
  "CflNumber": 5.0,
  "CflAdapt": true,
  "CflAdaptFactorDown": 0.5,
  "CflAdaptFactorUp": 1.2,
  "CflAdaptMin": 1.0,
  "CflAdaptMax": 50.0,

  // --- y+-Pruefung (Warnung, wenn das 95-%-Quantil ueber TargetYPlus x YPlusWarnFactor liegt) ---
  "TargetYPlus": 1.5,
  "YPlusWarnFactor": 3.0,

  // --- Zeitgenaue Rechnung (URANS) fuer instationaere Stroemungen; meist nur ueber `sim.ps1 recheck -Unsteady` ---
  "TimeDomain": {
    "Enabled": false,
    "TimeStep": 0.0,
    "StepsPerPeriod": 50,
    "StrouhalEstimate": 0.2,
    "TimeIterations": 1000,
    "InnerIterations": 30,
    "AveragingStartFraction": 0.5,
    "RestartIteration": 0
  }
}
