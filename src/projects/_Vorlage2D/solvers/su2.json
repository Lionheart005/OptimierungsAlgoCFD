{
  // MeinProjekt2D -- SU2-Solver. Was jeder Schluessel bewirkt: src/projects/BEDIENHANDBUCH.md
  //
  // Diese Datei nennt jeden Schluessel mit seinem Code-Standard (Solvers/Cfd/Su2SolverOptions.cs).
  // In einem echten Projekt bleibt nur stehen, was abweicht.

  // --- Fluid (Standard Meerwasser; Luft: 1.225 kg/m3 und 1.81e-5 Pa*s) ---
  "Density": 1025.0,            // kg/m3
  "DynamicViscosity": 0.001001, // Pa*s
  "TurbulenceModel": "SA",      // SA oder SST
  "SpeedOfSound": 343.2,        // m/s, Luftwert; nur fuer den Mach-Weg (FreestreamVelocity 0)

  // Anstroemgeschwindigkeit in m/s (Beispiel Naca2D: Luft, 51.48). 0 = MachNumber x SpeedOfSound.
  "FreestreamVelocity": 2.0,

  // --- Dimension, Anstellwinkel, Referenzwerte ---
  // Dimensions wird im 2D-Ablauf zur Laufzeit auf 2 gesetzt. Die Bezugsflaeche ist in 2D die Sehne ("Chord").
  "Dimensions": 3,
  "AngleOfAttackDeg": 0.0,
  "ReferenceLength": 0.01,
  "ReferenceAreaMetric": "FrontalArea",

  // --- Ergebnisgroessen (links: Name in der Fitness-Formel, rechts: Spalte der history.csv) ---
  "ResultMetrics": {
    "Drag": "CD"
  },

  "ConvergenceField": "DRAG",
  "HistoryOutput": [ "ITER", "RMS_RES", "AERO_COEFF" ],

  // --- Konvergenzbewertung ---
  // Echte Drift im Endfenster = fehlgeschlagen; reines Schwingen (Wirbelabloesung) bleibt gueltig.
  // TailMean = Mittel des Endfensters statt Endwert; OscillationWarnLimit ist nur eine Warnschwelle.
  "OscillationWarnLimit": 0.05,
  "TreatUnconvergedAsFailed": true,
  "ResultAveraging": "TailMean",

  // --- CFL ---
  "CflNumber": 5.0,
  "CflAdapt": true,
  "CflAdaptFactorDown": 0.5,
  "CflAdaptFactorUp": 1.2,
  "CflAdaptMin": 1.0,
  "CflAdaptMax": 50.0,

  // --- y+-Pruefung ---
  "TargetYPlus": 1.0,
  "YPlusWarnFactor": 3.0,

  // --- Zeitgenaue Rechnung (URANS) ---
  "TimeDomain": {
    "Enabled": false,
    "TimeStep": 0.0,
    "StepsPerPeriod": 50,
    "StrouhalEstimate": 0.2,
    "TimeIterations": 1000,
    "InnerIterations": 30,
    "AveragingStartFraction": 0.5,
    "RestartIteration": 0
  }
}
