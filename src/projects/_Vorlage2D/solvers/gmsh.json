{
  // MeinProjekt2D -- Gmsh-2D-Vernetzer. Was jeder Schluessel bewirkt: src/projects/BEDIENHANDBUCH.md
  //
  // Diese Datei nennt jeden Schluessel mit seinem Code-Standard (Solvers/Cfd/Gmsh2DMesherOptions.cs).
  // Alle Groessen sind Vielfache der Sehnenlaenge c (auf Netzstufe 1.0).

  // --- Fernfeld: Kreis mit Radius FarfieldRadiusFactor x c (500 wie die NASA-TMR-Gitter, kostet kaum Zellen) ---
  "FarfieldRadiusFactor": 500.0,
  "FarfieldCircleSegments": 64,

  // --- Grenzschicht (Schichtanzahl 0 = automatisch) ---
  "TargetYPlus": 1.0,
  "BoundaryLayerGrowthRate": 1.2,
  "BoundaryLayerMinLayers": 4,
  "BoundaryLayerLayers": 0,

  // --- Zellgroessen (SurfaceCellSizeMm in mm, wenn > 0; NearfieldGrowthDistanceFactor 0 = automatisch) ---
  "SurfaceCellSizeFactor": 0.01,
  "SurfaceCellSizeMm": 0.0,
  "NearfieldCellSizeFactor": 0.04,
  "FarfieldCellSizeFactor": 25.0,
  "NearfieldGrowthDistanceFactor": 0.0,

  // --- Feine Boxen hinter dem Profil ---
  "WakeRefinement": true,
  "WakeLengthFactor": 3.0,
  "WakeWidthFactor": 0.6,
  "WakeCellSizeFactor": 0.04,
  "DetailBox": true,
  "DetailBoxLengthFactor": 1.0,
  "DetailBoxWidthFactor": 0.25,
  "DetailBoxCellSizeFactor": 0.01,

  // --- Vorder- und Hinterkante: Wandzellgroesse dort = EdgeRefinementFactor x Konturzellgroesse (1 = aus) ---
  "EdgeRefinementFactor": 0.25,
  "EdgeRefinementDistanceFactor": 0.1
}
