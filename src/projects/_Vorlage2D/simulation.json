{
  // MeinProjekt2D -- Framework-Einstellungen. Was jeder Schluessel bewirkt: src/projects/BEDIENHANDBUCH.md
  //
  // Diese Datei nennt alle fuer 2D relevanten Schluessel mit ihrem Code-Standard
  // (Core/Models/SimulationConfig.cs); die reinen 3D-Voxel-Schluessel fehlen bewusst.
  // Die Standards sind auf genaue Rechnungen ausgelegt. Abweichungen: MaxIterations und
  // VariantsPerIteration (kleiner Testlauf), AutoStop (an) sowie MeshRefinementFactor (fehlt, siehe MeshCalibration).
  // In einem echten Projekt bleibt nur stehen, was abweicht -- den Rest loeschen.

  // --- Programme (PATH-relativ; `.\scripts\sim.ps1 doctor` zeigt, was gefunden wird) ---
  // Server: Heisst das Programm nur "mpirun" oder "mpiexec", nimmt das Programm automatisch das MPICH-Environment
  // (~/miniconda/envs/mpich/bin/mpiexec, legt setup_server.sh an), falls es existiert. Das OpenMPI im PATH startet
  // zwoelf serielle Kopien und liefert unbrauchbare Ergebnisse. Ein ausdruecklich eingetragener Pfad gilt unveraendert
  // (das Programm warnt beim Start, wenn er OpenMPI ist). Einrichtung: scripts/README.md.
  "MpiRunPath": "mpirun",
  "Su2Path": "SU2_CFD",
  "GmshPath": "gmsh",

  // --- Umfang: MaxIterations x VariantsPerIteration = Zahl der Rechnungen (Code-Standard 10 x 10) ---
  "MaxIterations": 5,
  "VariantsPerIteration": 5,

  // --- Automatisches Ende (siehe BEDIENHANDBUCH.md, Abschnitt 4.2; Code-Standard: "Off", Fenster 20) ---
  // Der Lauf endet frueher, wenn sich der Bestwert in den letzten WindowVariants Varianten um weniger als
  // MinImprovement (0.01 = 1 %) verbessert hat. MaxIterations x VariantsPerIteration bleibt die Obergrenze.
  // Fenster 10 = zwei Runden zu 5 Varianten: deckt den Bayes-Versuchsplan am Anfang ab; fruehestes Ende nach Runde 3.
  // Bei mehr Varianten je Runde das Fenster mitziehen (bewaehrt: 2 x VariantsPerIteration).
  "AutoStop": {
    "Mode": "On",
    "MinImprovement": 0.01,
    "WindowVariants": 10
  },

  "AutoVoxelResolution": false,
  "UseProjectedFrontalArea": true,

  // --- CFD & SU2 ---
  // MeshRefinementFactor steht bewusst nicht hier: bei MeshCalibration "Auto" kalibriert der Lauf ihn
  // selbst, und ein eingetragener Wert bricht den Start ab. Nur bei "Manual" eintragen.
  "Su2MaxIterations": 3000,
  "CauchyElements": 300,
  "CauchyTolerance": "1e-5",
  "MpiCores": 12,
  "GmshCores": 12,

  // --- Optimierungsverfahren: "Bayes" (Standard), "Rsm" oder "Evolution" ---
  // Bayes lernt aus den bisherigen Rechnungen und braucht Grenzen je Parameter (ParameterBounds in project.json).
  // Rsm ist bei sehr kleinem Budget (bis etwa 25 Rechnungen) gleichwertig und braucht keine Grenzen.
  "OptimizationAlgorithm": "Bayes",
  // 0 = bei jedem Lauf neu ziehen (steht in run-info.json); fester Wert = exakt wiederholbar.
  "RandomSeed": 0,

  // --- Rsm (am besten so lassen) ---
  "RsmVirtualSimulations": 50000,
  "RsmIdwPower": 3.0,
  "RsmExploitationRatio": 0.7,
  "RsmExploitationSigma": 0.1,

  // Evolution und Bayes stehen bewusst nicht in der Vorlage. Wer "Evolution" einstellen will, traegt
  // MinimalDeviationExploration, MinimalDeviationExploitation, RoleFineTuner, RoleCautious und
  // RoleNormal aus dem Handbuch (Abschnitt 4.2) hier ein; "Bayes" braucht keine Einstellung
  // (optional: "Bayes": { "SurrogateTarget": "Auto", "InitialSamples": 0 }).

  // --- Tuersteher (Bouncer): Champion wird mit leicht verstelltem Parameter nachgerechnet ---
  "BouncerTolerance": 0.2,
  "BouncerJitter": 0.01,

  // --- Konvergenz ---
  // Normale Varianten: erlaubte Drift im Endfenster als Bruchteil der Netz-Toleranz.
  // ControlRuns: strengeres Profil nur fuer Kontrollrechnungen (Kalibrierung, Feinpruefung, Recheck).
  "IterativeToleranceFraction": 0.25,
  "ControlRuns": {
    "Su2MaxIterations": 20000,
    "CauchyElements": 500,
    "CauchyTolerance": "1e-5",
    "IterativeToleranceFraction": 0.1
  },

  // --- Netzkalibrierung ("Auto": der Lauf bestimmt den Netzfaktor am Anfang selbst; in 2D wenige Minuten) ---
  "MeshCalibration": {
    "Mode": "Auto",
    "Tolerance": 0.05,
    "Use2DPrecalibration": false,
    "AbsoluteTolerances": {},
    "MaxCells2D": 2000000,
    "MaxCells3D": 3000000
  },

  // --- Feinpruefung: die TopN besten Varianten am Ende auf feinerem Netz nachrechnen ---
  // Mode: "Off" | "Final" | "FinalTopN" | "EachIteration"
  "ChampionVerification": {
    "Mode": "FinalTopN",
    "TopN": 3,
    "RefinementSteps": 1,
    "Tolerance": 0.05
  }
}
