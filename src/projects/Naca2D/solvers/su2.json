{
  "$schema": "../../../../schemas/su2.schema.json",
  // Full key reference: docs/config-reference.md | Presets: docs/physics-presets.md
  // ===================================================================
  //  Naca2D -- SU2 Solver (2D Multi-Point)
  // ===================================================================

  // --- Fluid properties (air at sea level, ISA 15 deg C) ---
  "Density": 1.225,
  "DynamicViscosity": 1.81e-5,
  "TurbulenceModel": "SA",
  "SpeedOfSound": 343.2,
  "FreestreamVelocity": 51.48,

  // --- Dimension & multi-point operating envelope ---
  "Dimensions": 2,
  "OperatingPoints": [
    { "Name": "CruiseLow", "AngleOfAttackDeg": 2.0, "Weight": 0.3 },
    { "Name": "CruiseNom", "AngleOfAttackDeg": 5.0, "Weight": 0.4 },
    { "Name": "ClimbHigh", "AngleOfAttackDeg": 8.0, "Weight": 0.3 }
  ],

  // --- Reference values ---
  "ReferenceLength": 0.05,
  "ReferenceAreaMetric": "Chord",

  // --- Result metrics ---
  "ResultMetrics": {
    "Drag": "CD",
    "Lift": "CL"
  },
  "ConvergenceField": "DRAG"
}
