{
  // Was jeder Schluessel bewirkt, in Klartext: src/projects/BEDIENHANDBUCH.md
  // ===================================================================
  //  Naca2D -- Framework-Einstellungen dieses Projekts
  // ===================================================================
  //
  // 2D-CFD-Optimierung und NASA-TMR-Validierung (TODO-47).
  // Pfade analog zu TestprojektNACA für den Hochschulserver (BIC_12).

  // --- Pfade zu externer Software ---
  "MpiRunPath": "/home/lpleissner/miniconda/bin/mpirun",
  "Su2Path": "/home/lpleissner/software/bin/SU2_CFD",
  "GmshPath": "/home/lpleissner/software/gmsh-4.11.1-Linux64/bin/gmsh",

  // --- Zeit & Umfang ---
  "MaxIterations": 3,
  "VariantsPerIteration": 3,
  "BaseVoxelResolution": 0.5,
  "TargetPicoGkSize": 50.0,
  "VoxelSmoothingIterations": 40,
  "VoxelSmoothingPremeltingSteps": 2,

  // --- Abschaltbare Framework-Bausteine ---
  // In 2D sind weder RubberBandScaler noch Voxel-Glättung aktiv (direkte 2D-Kontur).
  "UseRubberBandScaler": false,
  "UseStlSmoothing": false,

  // --- CFD & SU2 ---
  // Mach 0.15 entspricht der NASA TMR NACA 0012 Validierungsbedingung.
  "MachNumber": 0.15,
  "MeshRefinementFactor": 1.0,
  "Su2MaxIterations": 500,
  "CauchyElements": 150,
  "CauchyTolerance": "1e-4",
  "MpiCores": 12,
  "GmshCores": 12,

  // --- Optimierungsverfahren: "Rsm" oder "Evolution" ---
  "OptimizationAlgorithm": "Rsm",

  // --- Evolutionärer Algorithmus ---
  "MinimalDeviationExploration": 1.0,
  "MinimalDeviationExploitation": 0.05,
  "RoleFineTuner": 0.2,
  "RoleCautious": 0.4,
  "RoleNormal": 0.6,

  // --- RSM (Antwortflächen-Verfahren) ---
  "RsmVirtualSimulations": 50000,
  "RsmIdwPower": 3.0,
  "RsmExploitationRatio": 0.7,
  "RsmExploitationSigma": 0.1,

  // --- Validierung des Champions (Bouncer) ---
  "BouncerTolerance": 0.2,
  "BouncerJitter": 0.01
}
