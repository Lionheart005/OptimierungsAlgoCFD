{
  // Was jeder Schluessel bewirkt, in Klartext: src/projects/BEDIENHANDBUCH.md
  // ===================================================================
  //  Naca2D -- Framework-Einstellungen dieses Projekts
  // ===================================================================
  //
  // 2D-CFD-Optimierung und NASA-TMR-Validierung (TODO-47).
  // Pfade analog zu TestprojektNACA für den Hochschulserver (BIC_12).

  // --- Pfade zu externer Software ---
  // MPICH, nicht das OpenMPI aus Miniconda: das offizielle SU2-7.5.1-Binary ist statisch
  // mit MPICH gebaut. Unter OpenMPI startete "-n 12" zwoelf unabhaengige SERIELLE Kopien,
  // die sich gegenseitig die Dateien ueberschrieben (Servertest 06.11.2026). Eingerichtet mit
  // "conda create -n mpich -c conda-forge mpich" (siehe setup_server.sh).
  "MpiRunPath": "/home/lpleissner/miniconda/envs/mpich/bin/mpiexec",
  "Su2Path": "/home/lpleissner/software/bin/SU2_CFD",
  "GmshPath": "/home/lpleissner/software/gmsh-4.11.1-Linux64/bin/gmsh",

  // --- Zeit & Umfang ---
  "MaxIterations": 10,
  "VariantsPerIteration": 10,

  // --- CFD & SU2 ---
  // MeshRefinementFactor steht hier bewusst NICHT: im Auto-Modus (MeshCalibration unten) kalibriert der Lauf
  // den Netzfaktor am Anfang selbst.
  //
  // Normale Varianten: moderate Konvergenz. Kontrollrechnungen (Kalibrierung, Feinpruefung, Recheck) rechnen mit
  // dem strengen Profil "ControlRuns" (Vorgabe: bis 20000 Iterationen, Fenster 500, iterativer Fehler <= 1/10).
  // Seit TODO-W3 entscheidet die Drift der Kennwerte im Endfenster, ob eine Rechnung konvergiert ist.
  "Su2MaxIterations": 3000,
  "CauchyElements": 300,
  "CauchyTolerance": "1e-5",
  "MpiCores": 12,
  "GmshCores": 12,

  // --- Optimierungsverfahren: "Rsm", "Evolution" oder "Bayes" ---
  "OptimizationAlgorithm": "Rsm",

  // --- Evolutionärer Algorithmus ---
  "MinimalDeviationExploration": 1.0,
  "MinimalDeviationExploitation": 0.05,
  "RoleFineTuner": 0.2,
  "RoleCautious": 0.4,
  "RoleNormal": 0.6,

  // --- RSM (Antwortflächen-Verfahren) ---
  "RsmVirtualSimulations": 50000,
  "RsmIdwPower": 3.0,
  "RsmExploitationRatio": 0.7,
  "RsmExploitationSigma": 0.1,

  // --- Bayes-Optimierer (nur bei "OptimizationAlgorithm": "Bayes", alles optional) ---
  // Meist nicht noetig: "Bayes" laeuft ohne Einstellung. Jeder Parameter braucht Grenzen in
  // project.json (ParameterBounds); MaxDeviations wirkt bei "Bayes" nicht. Erklaerung der Schluessel:
  // src/projects/BEDIENHANDBUCH.md, Abschnitt 4.2.
  // "Bayes": {
  //   "SurrogateTarget": "Auto",   // "Auto" | "Fitness" | "Metrics"
  //   "InitialSamples": 0          // 0 = automatisch: max(VariantsPerIteration, 2 x freie Parameter + 2)
  // },

  // --- Netzkalibrierung am Laufanfang (TODO-42, TODO-W5) ---
  // Auto: die Kalibrierung rechnet Stufen 2.0 ... 0.5 und verfeinert bei Bedarf weiter (0.35, 0.25, ...),
  // bis eine groebere Stufe die Toleranz gegenueber der feinsten haelt (kombinierte Toleranz mit Mindestbetrag).
  "MeshCalibration": {
    "Mode": "Auto",
    "Tolerance": 0.05
  },

  // --- Feine Nachrechnung der besten Varianten (TODO-43) ---
  "ChampionVerification": {
    "Mode": "FinalTopN",
    "TopN": 3,
    "RefinementSteps": 1,
    "Tolerance": 0.05
  },

  // --- Validierung des Champions (Bouncer) ---
  "BouncerTolerance": 0.10,
  "BouncerJitter": 0.01
}
