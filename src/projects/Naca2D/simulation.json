{
  "$schema": "../../../schemas/simulation.schema.json",
  // Full key reference: docs/config-reference.md | Presets: docs/physics-presets.md
  // ===================================================================
  //  Naca2D -- Framework Settings for This Project
  // ===================================================================
  //
  // 2D CFD multi-point optimization and NASA TMR validation.
  // Inherits External2D:StandardRans (Auto calibration at 5%, Cauchy 5e-5, y+ ~ 1.0).

  "Preset": "External2D:StandardRans",

  // --- Iterations & budget ---
  "MaxIterations": 10,
  "VariantsPerIteration": 10,

  // --- Server parallelism ---
  "MpiCores": 12,
  "GmshCores": 12,

  // --- Champion validation (bouncer) ---
  "BouncerTolerance": 0.10,
  "BouncerJitter": 0.01
}
