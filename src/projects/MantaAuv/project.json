{
  // ===================================================================
  //  MantaAuv -- Projektvorgaben
  // ===================================================================
  //
  // Die Manifestdatei heisst in JEDEM Projekt "project.json" (Entscheidung 2).
  // Ein Dateiname, der ueberall derselbe ist, kann nicht mit dem Projektnamen
  // verwechselt werden -- "config/projects/MantaAuv.json" konnte das.
  //
  // DER PROJEKTNAME STEHT NIRGENDS IN DIESER DATEI. Er ist der Ordnername
  // (Entscheidung 1): dieser Ordner heisst MantaAuv, also heisst das Projekt so,
  // und gestartet wird mit
  //
  //     .\scripts\sim.ps1 run -Project MantaAuv
  //
  // Was hier fehlt, kommt aus den Code-Vorgaben in MantaProjectConfig.cs
  // nebenan. Ein unbekannter Schluessel bricht den Start ab -- ausser INNERHALB
  // der Zuordnungen unten: dort sind die Schluessel Parameternamen und frei
  // waehlbar.
  //
  // Nur Zahlen und Namen -- Geometrie-Erzeugung und Fitness-Formel bleiben
  // C#-Code, nebenan in diesem Ordner (Entscheidung 7).
  //
  // Das Optimierungsverfahren steht in simulation.json ("OptimizationAlgorithm"),
  // weil das Verfahren eine Framework-Einstellung ist und keine Projekteigenschaft.

  // --- Startwerte der aktiven Parameter (mm, ausser TailTaper) ---
  "BaseParameters": {
    "Length": 50.0,
    "Width": 40.0,
    "MainRadius": 4.0,
    "WingRadius": 3.0,
    "TailTaper": 1.0
  },

  // --- Anfängliche Mutationsstärke (Sigma-Streuung) ---
  "MaxDeviations": {
    "Length": 5.0,
    "Width": 4.0,
    "MainRadius": 1.0,
    "WingRadius": 1.0,
    "TailTaper": 0.1
  },

  // --- Harte Grenzen für physikalische Plausibilität ---
  "ParameterBounds": {
    "Length": { "Min": 30.0, "Max": 100.0 },
    "Width": { "Min": 20.0, "Max": 80.0 },
    "MainRadius": { "Min": 4.0, "Max": 15.0 },
    "WingRadius": { "Min": 2.0, "Max": 10.0 },
    "TailTaper": { "Min": 0.1, "Max": 1.5 }
  },

  // --- Optimierungsziele (gehen in die Fitness-Formel ein) ---
  // Fitness = (Volume * SensorDistance) / Drag^DragBalanceFactor,
  // Strafe x0.1 ausserhalb des erlaubten Volumenbereichs.
  "OptimizationTargets": {
    "MinimumAllowedVolume": 2000.0,
    "MaximumAllowedVolume": 85000.0,
    "DragBalanceFactor": 3.0
  },

  // --- Dimensionsbehaftete Parameter (werden mitskaliert) ---
  // TailTaper ist dimensionslos und steht bewusst NICHT in dieser Liste.
  "DimensionalParameters": [ "Length", "Width", "MainRadius", "WingRadius" ]
}
