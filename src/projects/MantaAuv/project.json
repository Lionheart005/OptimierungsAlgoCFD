{
  "$schema": "../../../schemas/project.schema.json",
  // Full key reference: docs/config-reference.md | Project guide: docs/creating-a-project.md
  // ===================================================================
  //  MantaAuv -- Project Settings
  // ===================================================================
  //
  // The manifest file is named "project.json" in EVERY project.
  //
  // THE PROJECT NAME IS NEVER WRITTEN IN THIS FILE. It comes from the folder name:
  // this folder is MantaAuv, so the project is MantaAuv, launched via:
  //
  //     .\scripts\sim.ps1 run -Project MantaAuv
  //
  // Anything omitted here falls back to code defaults in MantaProjectConfig.cs.
  // An unknown key aborts startup -- except inside the parameter dictionaries below,
  // where keys are user-defined parameter names.
  //
  // Numbers and names only -- geometry generation and fitness formula remain C# code
  // alongside this file.
  //
  // The optimization algorithm is configured in simulation.json ("OptimizationAlgorithm")
  // because it is a framework setting rather than a project property.

  // --- Initial active parameter values (mm, except TailTaper) ---
  "BaseParameters": {
    "Length": 50.0,
    "Width": 40.0,
    "MainRadius": 4.0,
    "WingRadius": 3.0,
    "TailTaper": 1.0
  },

  // --- Initial mutation step sizes (sigma) ---
  "MaxDeviations": {
    "Length": 5.0,
    "Width": 4.0,
    "MainRadius": 1.0,
    "WingRadius": 1.0,
    "TailTaper": 0.1
  },

  // --- Hard bounds for physical plausibility ---
  "ParameterBounds": {
    "Length": { "Min": 30.0, "Max": 100.0 },
    "Width": { "Min": 20.0, "Max": 80.0 },
    "MainRadius": { "Min": 4.0, "Max": 15.0 },
    "WingRadius": { "Min": 2.0, "Max": 10.0 },
    "TailTaper": { "Min": 0.1, "Max": 1.5 }
  },

  // --- Optimization targets & pre-CFD volume constraints ---
  // HydrodynamicEfficiency = SensorDistance / C_{D,V}^DragBalanceFactor,
  // where C_{D,V} = CD * FrontalArea / Volume^(2/3).
  // Volume outside [MinimumAllowedVolume, MaximumAllowedVolume] is rejected pre-CFD.
  "OptimizationTargets": {
    "MinimumAllowedVolume": 2000.0,
    "MaximumAllowedVolume": 85000.0,
    "DragBalanceFactor": 3.0
  },

  // --- Dimensional parameters (scaled by RubberBandScaler) ---
  // TailTaper is dimensionless and intentionally NOT in this list.
  "DimensionalParameters": [ "Length", "Width", "MainRadius", "WingRadius" ]
}
