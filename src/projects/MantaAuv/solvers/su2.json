{
  "$schema": "../../../../schemas/su2.schema.json",
  // Full key reference: docs/config-reference.md | Presets: docs/physics-presets.md
  // ===================================================================
  //  MantaAuv -- SU2 Solver (3D Y0 Symmetry)
  // ===================================================================

  "SymmetryPlane": "Y0",

  // --- Fluid properties (seawater) ---
  "Density": 1025.0,
  "DynamicViscosity": 0.001001,
  "TurbulenceModel": "SA",
  "SpeedOfSound": 343.2,
  "FreestreamVelocity": 2.0,

  // --- Reference values ---
  "ReferenceLength": 0.01,
  "ReferenceAreaMetric": "FrontalArea",

  // --- Result metrics ---
  "ResultMetrics": {
    "Drag": "CD"
  },
  "ConvergenceField": "DRAG",

  // --- Convergence & y+ check ---
  "AutoRestartOnDrift": true,
  "MaxConvergenceRestarts": 3,
  "TargetYPlus": 1.5,
  "YPlusWarnFactor": 3.0
}
