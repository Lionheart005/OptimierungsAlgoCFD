{
  "$schema": "../../../../schemas/gmsh.schema.json",
  // Full key reference: docs/config-reference.md | Presets: docs/physics-presets.md
  // ===================================================================
  //  MantaAuv -- Gmsh 3D Mesher (Y0 Symmetry Half-Model)
  // ===================================================================

  "SymmetryPlane": "Y0",

  // --- Wind tunnel (simulation domain) in mm ---
  "TunnelShape": "Box",
  "TunnelSizeX": 1200.0,
  "TunnelSizeY": 300.0,
  "TunnelSizeZ": 300.0,
  "TunnelCenterX": 300.0,
  "TunnelCenterY": 0.0,
  "TunnelCenterZ": 0.0,

  // --- Physical domain guarantees ---
  "TunnelMinUpstreamFactor": 5.0,
  "TunnelMinDownstreamFactor": 15.0,
  "TunnelMinLateralFactor": 5.0,
  "TunnelMaxBlockagePercent": 0.3,

  // --- Wall layer, wake & detail refinement ---
  "BoundaryLayerMode": "Prism",
  "TargetYPlus": 1.5,
  "BoundaryLayerGrowthRate": 1.28,
  "WakeRefinement": true,
  "DetailBox": true,
  "DetailBoxLengthFactor": 1.5,
  "DetailBoxWidthFactor": 0.25,
  "DetailBoxMinHeightLengthFactor": 0.15,
  "MeshSizeFromCurvature": true,
  "CurvatureElements": 20,
  "CurvatureMinSizeFactor": 0.5
}
