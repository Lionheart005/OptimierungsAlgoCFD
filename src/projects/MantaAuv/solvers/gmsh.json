  //
  // Was hier fehlt, kommt aus den Standardwerten in
  // Solvers/Cfd/GmshMesherOptions.cs. Ein unbekannter Schluessel bricht den
  // Start ab (TODO-22).
  //
  // Nicht hier, sondern in ../simulation.json: GmshCores und GmshPath.
  //
  // Abweichungen fuer einen einzelnen Rechner gehoeren in gmsh.local.json
  // daneben (gitignored). Sollstand ist, dass es keine gibt.

  // --- Windkanal (Simulationsdomäne) in mm ---
  // "Box" = Quader aus TunnelSize*, "Cylinder" = Zylinder mit Achse entlang X
  // aus TunnelDiameter/TunnelLength/TunnelSegments. Beide sitzen auf TunnelCenter*.
  "TunnelShape": "Box",
  "TunnelSizeX": 600.0,
  "TunnelSizeY": 300.0,
  "TunnelSizeZ": 300.0,
  "TunnelCenterX": 0.0,
  "TunnelCenterY": 0.0,
  "TunnelCenterZ": 0.0,

  // --- Zylinder-Windkanal (wirkt nur bei TunnelShape = "Cylinder") ---
  "TunnelDiameter": 300.0,
  "TunnelLength": 600.0,
  "TunnelSegments": 64,

  // --- Grenzschicht-Feld (Gmsh Threshold Field) ---
  "BoundaryLayerSizeMin": 1.2,
  "BoundaryLayerSizeMax": 120.0,
  "BoundaryLayerDistMin": 3.0,
  "BoundaryLayerDistMax": 40.0
}
