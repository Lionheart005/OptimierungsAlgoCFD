{
  "$schema": "../../../schemas/simulation.schema.json",
  // Full key reference: docs/config-reference.md | Presets: docs/physics-presets.md
  // ===================================================================
  //  MantaAuv -- Framework Settings for This Project
  // ===================================================================
  //
  // Inherits External3D:StandardRans (Prism y+ ~ 1.5, Cauchy 5e-5, AutoRestartOnDrift).
  // Project overrides tune voxel kernel, SU2 iteration budget, and 3D calibration limits.

  "Preset": "External3D:StandardRans",

  // --- Iterations & budget ---
  "MaxIterations": 10,
  "VariantsPerIteration": 10,

  // --- Geometry & Voxel Kernel (3D PicoGK) ---
  "BaseVoxelResolution": 0.5,
  "AutoVoxelResolution": false,
  "TargetPicoGkSize": 50.0,
  "VoxelSmoothingIterations": 40,
  "VoxelSmoothingPremeltingSteps": 2,
  "UseRubberBandScaler": true,
  "UseStlSmoothing": true,
  "UseProjectedFrontalArea": true,

  // --- CFD & SU2 ---
  "Su2MaxIterations": 5000,
  "MpiCores": 12,
  "GmshCores": 12,

  // --- Calibration & verification ---
  "MeshCalibration": {
    "Mode": "Auto",
    "Use2DPrecalibration": false,
    "Tolerance": 0.15,
    "MaxCells3D": 5000000
  },
  "ChampionVerification": {
    "Mode": "FinalTopN",
    "TopN": 3,
    "RefinementSteps": 1
  },

  // --- Champion validation (bouncer) ---
  "BouncerTolerance": 0.15,
  "BouncerJitter": 0.01
}
