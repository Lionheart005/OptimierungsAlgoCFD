{
  // Was jeder Schluessel bewirkt, in Klartext: src/projects/BEDIENHANDBUCH.md
  // ===================================================================
  //  MantaAuv -- Framework-Einstellungen dieses Projekts
  // ===================================================================
  //
  // Was hier fehlt, kommt aus den Standardwerten in
  // Core/Models/SimulationConfig.cs. Eingetragen gehoert also nur, was vom
  // Code-Standard ABWEICHT -- alles andere ist Rauschen, das beim naechsten
  // Framework-Update veraltet.
  //
  // Ein unbekannter Schluessel bricht den Start ab (TODO-22). Der Abbruch nennt
  // den Schluessel und den naechstaehnlichen gueltigen Namen.
  //
  // Ein zweites Projekt hat seine eigene Datei unter src/projects/<Name>/ und
  // kommt dieser hier nicht in die Quere.
  //
  // Maschinenspezifische Ausnahmen gehoeren in eine simulation.local.json
  // (gitignored). SOLLSTAND IST, DASS ES KEINE GIBT: findet der Start eine,
  // meldet er sie mit jedem Schluessel, den sie diesem Projekt aushebelt.

  // --- Pfade zu externer Software ---
  //
  // DER CODE-STANDARD IST PATH-RELATIV ("mpirun", "SU2_CFD", "gmsh"), siehe
  // Core/Models/SimulationConfig.cs. Ein Projekt, das nichts eintraegt, sucht die
  // Programme also ueber den PATH -- das ist der Normalfall und funktioniert auf
  // jedem Rechner, der sie regulaer installiert hat.
  //
  // DIESES Projekt traegt sie trotzdem absolut ein, weil der Hochschulserver
  // (BIC_12) sie nicht ueber den PATH findet: SU2 und Gmsh sind dort von Hand
  // nach ~/software entpackt, mpiexec kommt aus dem conda-Env "mpich". Bei "ssh host befehl"
  // startet bash nicht-interaktiv und Ubuntus ~/.bashrc steigt sofort wieder aus,
  // deshalb greift dort nichts aus conda init.
  //
  // Die Pfade stammen aus setup_server.sh.
  // Aendert sich die Gmsh-Version, aendert sich auch dieser Pfad.
  //
  // Auf einem anderen Server: diese drei Zeilen loeschen, dann gilt wieder der
  // PATH-relative Code-Standard. Welche Variante greift, sagt `sim.ps1 doctor`
  // VOR dem Lauf -- er nennt bei jedem Programm den tatsaechlich gefundenen Ort.
  // MPICH, nicht das OpenMPI aus Miniconda: das offizielle SU2-7.5.1-Binary ist statisch
  // mit MPICH gebaut. Unter OpenMPI startete "-n 12" zwoelf unabhaengige SERIELLE Kopien,
  // die sich gegenseitig die Dateien ueberschrieben (Servertest 06.11.2026). Eingerichtet mit
  // "conda create -n mpich -c conda-forge mpich" (siehe setup_server.sh).
  "MpiRunPath": "/home/lpleissner/miniconda/envs/mpich/bin/mpiexec",
  "Su2Path": "/home/lpleissner/software/bin/SU2_CFD",
  "GmshPath": "/home/lpleissner/software/gmsh-4.11.1-Linux64/bin/gmsh",

  // --- Zeit & Umfang ---
  // MaxIterations x VariantsPerIteration = Anzahl der gerechneten Varianten.
  // Fuer einen kurzen Testlauf hier heruntersetzen und neu deployen -- es gibt
  // kein verstecktes zweites Stellrad mehr.
  "MaxIterations": 10,
  "VariantsPerIteration": 10,

  // --- Automatisches Ende: aus (Standard). Zum Einschalten die letzte Zeile einkommentieren ---
  // Der Lauf endet frueher, wenn sich der Bestwert in den letzten WindowVariants Varianten um weniger
  // als MinImprovement (0.01 = 1 %) verbessert hat; MaxIterations x VariantsPerIteration bleibt die
  // Obergrenze. Erklaerung: src/projects/BEDIENHANDBUCH.md, Abschnitt 4.2.
  // "AutoStop": { "Mode": "On", "MinImprovement": 0.01, "WindowVariants": 20 },
  "BaseVoxelResolution": 0.5,
  "TargetPicoGkSize": 50.0,
  "VoxelSmoothingIterations": 40,
  "VoxelSmoothingPremeltingSteps": 2,

  // --- Abschaltbare Framework-Bausteine ---
  // Scaler aus: der Geometrie-Kernel arbeitet mit den echten Massen, ScaleFactor bleibt 1.
  // Smoother aus: die STL kommt unveraendert aus dem Voxel-Modell.
  "UseRubberBandScaler": true,
  "UseStlSmoothing": true,

  // --- CFD & SU2 ---
  // Seit 06.11.2026 (TODO-W8) rechnet MantaAuv mit Prismen-Wandschicht (y+ ~ 1) und grossem Kanal:
  // Ergebnisse davor (y+ 40-70, Kanal 6 L) und danach sind NICHT vergleichbar.
  // Netzfaktor 0.71: so lief der validierte Servertest (4 x 4, Feinpruefung der Top 3 mit 0.50; 06.11.2026). Der Widerstand
  // ist auf diesem Netz noch nicht netzunabhaengig (CD 0.171 grob gegen 0.146 fein), die Rangfolge der Varianten haelt
  // aber zu 100 %. Absolute Werte daher nur mit Vorsicht lesen; fuer genaue Werte `sim.ps1 calibrate` und den Faktor ersetzen.
  "MeshRefinementFactor": 0.71,
  "Su2MaxIterations": 2000,
  "CauchyElements": 300,
  "CauchyTolerance": "1e-5",
  "MpiCores": 16,
  "GmshCores": 16,

  // --- Optimierungsverfahren: "Rsm", "Evolution" oder "Bayes" ---
  // Der Code-Standard ist seit 08.11.2026 "Bayes". MantaAuv bleibt ausdruecklich bei "Rsm", bis Bayes im 3D-Fall (Modus
  // "Metrics") auf dem Server gemessen ist; dann diese Zeile loeschen. Ein unbekannter Name warnt und faellt auf den Standard zurueck.
  "OptimizationAlgorithm": "Rsm",

  // --- Evolutionärer Algorithmus ---
  "MinimalDeviationExploration": 1.0,
  "MinimalDeviationExploitation": 0.05,
  "RoleFineTuner": 0.2,
  "RoleCautious": 0.4,
  "RoleNormal": 0.6,

  // --- RSM (Antwortflächen-Verfahren) ---
  "RsmVirtualSimulations": 50000,
  "RsmIdwPower": 3.0,
  "RsmExploitationRatio": 0.7,
  "RsmExploitationSigma": 0.1,

  // --- Bayes-Optimierer (nur bei "OptimizationAlgorithm": "Bayes", alles optional) ---
  // Meist nicht noetig: "Bayes" laeuft ohne Einstellung. Jeder Parameter braucht Grenzen in
  // project.json (ParameterBounds); MaxDeviations wirkt bei "Bayes" nicht. Erklaerung der Schluessel:
  // src/projects/BEDIENHANDBUCH.md, Abschnitt 4.2.
  // "Bayes": {
  //   "SurrogateTarget": "Auto",   // "Auto" | "Fitness" | "Metrics"
  //   "InitialSamples": 0          // 0 = automatisch: max(VariantsPerIteration, 2 x freie Parameter + 2)
  // },

  // --- Kontrollrechnungen und Netzkalibrierung (TODO-W4, TODO-W5) ---
  // 3D kostet je Iteration ein Vielfaches von 2D: das strenge Profil ist hier auf 8000 Iterationen begrenzt
  // (Vorgabe 20000), die Kalibrierung hoert bei ~3 Mio. Zellen der feinsten Stufe auf zu verfeinern.
  "ControlRuns": {
    "Su2MaxIterations": 8000,
    "CauchyElements": 500
  },
  // Mode "Manual" bewusst festgehalten (Standard ist seit 08.11.2026 "Auto"): eine 3D-Kalibrierung kostet hier
  // ~4 h je Laufstart (Servertest 06.11.2026). Kalibrieren per `sim.ps1 calibrate`, Faktor dann eintragen.
  "MeshCalibration": {
    "Mode": "Manual",
    "Tolerance": 0.02,
    "MaxCells3D": 3000000
  },
  "ChampionVerification": {
    "Mode": "FinalTopN",
    "TopN": 3,
    "RefinementSteps": 1
  },

  // --- Validierung des Champions (Bouncer) ---
  // Erlaubte relative Abweichung der FITNESS bei der Re-Simulation.
  // Achtung: prüfte früher den Drag; die Fitness reagiert empfindlicher,
  // der Wert muss beim ersten echten Lauf nachjustiert werden.
  "BouncerTolerance": 0.2,
  "BouncerJitter": 0.01
}
