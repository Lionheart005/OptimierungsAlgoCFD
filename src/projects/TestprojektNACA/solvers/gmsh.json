{
  // Was jeder Schluessel bewirkt, in Klartext: src/projects/BEDIENHANDBUCH.md
  // ===================================================================
  //  TestprojektNACA -- Gmsh-Vernetzer
  // ===================================================================

  // Randbedingungen: Die SU2-Markernamen ("Farfield" fuer den Kanal, "Wall" fuer
  // das Modell) werden im Vernetzungsskript vergeben: Solvers/Cfd/GmshCfdMesher.cs

  // --- Windkanal (Simulationsdomäne) in mm ---
  // Empfehlung fuer Nachlauf-Erfassung: Den Tunnelmittelpunkt stromabwaerts verschieben
  // (positives TunnelCenterX), sodass hinter dem Modell mindestens 10 Koerperlaengen (>= 10 L)
  // Platz bleiben (z. B. bei 50 mm Modell: TunnelCenterX = 100 mm im 600 mm Tunnel ergibt
  // 4 L vorn und 8 L hinten, oder bei TunnelSizeX = 800 mm und TunnelCenterX = 150 mm >= 10 L hinten).
  "TunnelShape": "Box",
  "TunnelSizeX": 600.0,
  "TunnelSizeY": 300.0,
  "TunnelSizeZ": 300.0,
  "TunnelCenterX": 0.0,
  "TunnelCenterY": 0.0,
  "TunnelCenterZ": 0.0,

  // --- Zylinder-Windkanal (wirkt nur bei TunnelShape = "Cylinder") ---
  "TunnelDiameter": 300.0,
  "TunnelLength": 600.0,
  "TunnelSegments": 64,

  // --- Grenzschicht-Feld (Gmsh Threshold Field) ---
  "BoundaryLayerSizeMin": 1.2,
  "BoundaryLayerSizeMax": 120.0,
  "BoundaryLayerDistMin": 3.0,
  "BoundaryLayerDistMax": 40.0,

  // Feine Detailbox direkt um und hinter dem Modell (Maße automatisch aus Körper-Bounding-Box: true/false)
  "DetailBox": false,
  "DetailBoxLengthFactor": 1.0,
  "DetailBoxWidthFactor": 0.25,
  "DetailBoxCellSize": 0.0
}
