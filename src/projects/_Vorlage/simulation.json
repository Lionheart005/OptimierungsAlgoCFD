{
  // Was jeder Schluessel bewirkt, in Klartext: src/projects/BEDIENHANDBUCH.md
  // ===================================================================
  //  MeinProjekt -- Framework-Einstellungen dieses Projekts
  // ===================================================================
  //
  // DIESE DATEI IST EIN NACHSCHLAGEWERK: sie nennt JEDEN Schluessel, den das
  // Framework kennt, mit dem Wert aus dem Code-Standard
  // (Core/Models/SimulationConfig.cs). Die Standards sind auf genaue Rechnungen
  // ausgelegt (Netz automatisch kalibriert, strenge Konvergenz, Feinpruefung der
  // besten Varianten); ohne Aenderung ist ein Lauf physikalisch belastbar.
  // Ausnahmen: MaxIterations und VariantsPerIteration sind fuer einen kurzen
  // ersten Lauf heruntergesetzt, und MeshRefinementFactor fehlt (Auto-Modus).
  // Ein Test haelt das fest (TemplateProjectTests).
  //
  // IN EINEM ECHTEN PROJEKT STEHT HIER NUR NOCH, WAS ABWEICHT. Alles andere
  // darfst und sollst du loeschen: ein Schluessel mit dem Standardwert ist
  // Rauschen, das beim naechsten Framework-Update veraltet. MantaAuv nebenan
  // zeigt, wie kurz so eine Datei dann ist.
  //
  // Ein unbekannter Schluessel bricht den Start ab (TODO-22). Der Abbruch nennt
  // den Schluessel und den naechstaehnlichen gueltigen Namen -- ein Tippfehler
  // rechnet also nicht stundenlang stillschweigend mit dem Standardwert weiter.
  //
  // Jedes Projekt hat seine eigene Datei unter src/projects/<Name>/ und kommt
  // den anderen nicht in die Quere.
  //
  // Maschinenspezifische Ausnahmen gehoeren in eine simulation.local.json
  // (gitignored). SOLLSTAND IST, DASS ES KEINE GIBT: findet der Start eine,
  // meldet er sie mit jedem Schluessel, den sie diesem Projekt aushebelt.

  // --- Pfade zu externer Software ---
  //
  // PATH-RELATIV IST DER NORMALFALL: .NET loest einen blossen Programmnamen
  // ueber den PATH auf, und scripts/sim-runner.sh legt in load_env die
  // ueblichen Installationsverzeichnisse dorthin. Auf einem Rechner, der SU2,
  // Gmsh und MPI regulaer installiert hat, sind diese drei Zeilen richtig.
  //
  // Findet dein Server sie nicht, dann trage sie hier ABSOLUT ein -- so macht es
  // MantaAuv fuer den Hochschulserver. Welche Variante greift, sagt
  // `.\scripts\sim.ps1 doctor` VOR dem Lauf: er nennt bei jedem Programm den
  // tatsaechlich gefundenen Ort.
  "MpiRunPath": "mpirun",
  "Su2Path": "SU2_CFD",
  "GmshPath": "gmsh",

  // --- Zeit & Umfang ---
  //
  // MaxIterations x VariantsPerIteration = Anzahl der gerechneten Varianten.
  //
  // ABWEICHUNG VOM CODE-STANDARD (dort 10 x 10 = 100): die Vorlage steht auf
  // 1 x 2 = 2 Varianten, damit der erste Lauf eines neuen Projekts ein
  // RAUCHTEST ist und keine Nachtschicht. Er beantwortet die Frage "laeuft die
  // Kette ueberhaupt durch" (plus Netzkalibrierung am Anfang, siehe MeshCalibration
  // unten). Sitzt Geometrie und Fitness, dann hier
  // hochsetzen und neu deployen -- es gibt kein verstecktes zweites Stellrad.
  "MaxIterations": 1,
  "VariantsPerIteration": 2,

  // Voxelkantenlaenge in mm: kleiner = feineres Modell = deutlich langsamer.
  "BaseVoxelResolution": 0.5,
  // Groesse, auf die der RubberBandScaler die Geometrie fuer PicoGK bringt.
  "TargetPicoGkSize": 50.0,
  "VoxelSmoothingIterations": 40,
  "VoxelSmoothingPremeltingSteps": 2,

  // --- Abschaltbare Framework-Bausteine ---
  // Scaler aus: der Geometrie-Kernel arbeitet mit den echten Massen, ScaleFactor
  //   bleibt 1 -- dann muessen die Parameter selbst in einer Groesse liegen, mit
  //   der PicoGK gut umgehen kann.
  // Smoother aus: die STL kommt unveraendert aus dem Voxel-Modell, mit Treppen.
  // UseProjectedFrontalArea: true = wahre projizierte Silhouette in der YZ-Ebene,
  //   false = bisherige Huellquader-Naeherung (Size.Y * Size.Z).
  "UseRubberBandScaler": true,
  "UseStlSmoothing": true,
  "UseProjectedFrontalArea": true,

  // --- CFD & SU2 ---
  // MeshRefinementFactor steht hier bewusst NICHT: im Auto-Modus (MeshCalibration unten) kalibriert
  // der Lauf den Netzfaktor am Anfang selbst, und ein eingetragener Faktor bricht den Start ab.
  // Nur bei "Mode": "Manual" eintragen: 1.0 = Basisgroessen aus gmsh.json, < 1.0 = feiner
  // (0.5 halbiert alle Zellkanten), > 1.0 = groeber fuer schnelle Vorablaeufe.
  //
  // Obergrenze der SU2-Iterationen je Variante; CauchyElements/CauchyTolerance brechen frueher ab,
  // sobald die Zielgroesse ruhig liegt. Ob eine Rechnung wirklich konvergiert ist, entscheidet danach
  // die Drift der Kennwerte im Endfenster (TODO-W3). 3000 reicht fuer RANS mit y+ ~ 1.
  "Su2MaxIterations": 3000,
  "CauchyElements": 300,
  "CauchyTolerance": "1e-5",
  // Kerne fuer mpirun bzw. Gmsh. Mehr als der Rechner hat, macht es langsamer.
  "MpiCores": 12,
  "GmshCores": 12,

  // --- Optimierungsverfahren: "Rsm", "Evolution" oder "Bayes" ---
  // Rsm       = Antwortflaechen-Verfahren, lernt aus allen bisherigen Laeufen.
  // Evolution = Mutation um den jeweils besten Kandidaten.
  // Bayes     = lernendes Ersatzmodell (Gauss-Prozess), spart bei teuren Rechnungen Varianten.
  // Ein unbekannter Name bricht nicht ab, sondern warnt und faellt auf "Rsm"
  // zurueck.
  "OptimizationAlgorithm": "Rsm",

  // Startwert des Zufalls. 0 = bei jedem Lauf neu ziehen (steht dann im Log und in
  // Ergebnisse/<Name>/run-info.json). Fuer eine exakte Wiederholung den Wert von dort
  // hier eintragen.
  "RandomSeed": 0,

  // --- RSM / Antwortflaechen-Verfahren (wirkt nur bei "Rsm") ---
  // Virtuelle Stichproben auf der Ersatzfunktion -- kostet keine Rechenzeit im
  // Solver, nur Sekundenbruchteile im Speicher. Am besten einfach so lassen:
  "RsmVirtualSimulations": 50000,
  "RsmIdwPower": 3.0,
  "RsmExploitationRatio": 0.7,
  "RsmExploitationSigma": 0.1,

  // --- Evolution und Bayes: Einstellungen stehen bewusst nicht in der Vorlage ---
  // Wer "OptimizationAlgorithm": "Evolution" nutzt und ihn einstellen will, traegt die Schluessel
  // MinimalDeviationExploration, MinimalDeviationExploitation, RoleFineTuner, RoleCautious und
  // RoleNormal aus dem Handbuch hier ein (ohne Eintrag gelten die dort genannten Vorgaben).
  // "Bayes" braucht keine Einstellung. Optional: "Bayes": { "SurrogateTarget": "Auto", "InitialSamples": 0 }.
  // Erklaerung: src/projects/BEDIENHANDBUCH.md, Abschnitt 4.2.

  // --- Validierung des Champions (Bouncer) ---
  // Der Gewinner einer Iteration wird mit minimal verstelltem Parameter noch
  // einmal komplett durchgerechnet. Weicht seine FITNESS um mehr als
  // BouncerTolerance ab, war das Ergebnis Zufall und der Kandidat fliegt raus.
  "BouncerTolerance": 0.2,
  "BouncerJitter": 0.01,

  // --- Genauigkeit der Konvergenz (TODO-W3, TODO-W4) ---
  // IterativeToleranceFraction: wie weit der ITERATIVE Fehler einer normalen Variante unter der
  //   Netz-Toleranz liegen muss (0.25 = ein Viertel). Gemessen wird die Drift der Kennwerte im
  //   Endfenster, nicht das Residuum.
  // ControlRuns: strenges Profil NUR fuer Kontrollrechnungen (Netzkalibrierung, Feinpruefung, Recheck):
  //   Su2MaxIterations, CauchyElements, CauchyTolerance und IterativeToleranceFraction (0.1 = ein Zehntel,
  //   Celik et al. 2008). Es gilt nie weniger als bei normalen Varianten.
  "IterativeToleranceFraction": 0.25,
  "ControlRuns": {
    "Su2MaxIterations": 20000,
    "CauchyElements": 500,
    "CauchyTolerance": "1e-6",
    "IterativeToleranceFraction": 0.1
  },

  // --- Netzkalibrierung (TODO-42, TODO-W5) ---
  // Mode: "Auto" (Standard: der Lauf rechnet am Anfang Netzstufen 2.0 ... 0.5 und verfeinert bei Bedarf
  //   weiter, bis eine groebere Stufe die Toleranz gegenueber der feinsten haelt; diesen Faktor nimmt er)
  //   oder "Manual" (dann MeshRefinementFactor oben eintragen).
  //   Achtung 3D: die Kalibrierung dauert dort Stunden (MantaAuv ~4 h). Wer nur pruefen will, ob die Kette
  //   durchlaeuft, stellt fuer den ersten Rauchtest "Manual" ein.
  // Tolerance: erlaubte relative Abweichung aller Ergebnisgroessen gegenueber der feinsten Referenzstufe (5 %).
  // Use2DPrecalibration: 2D-Vorkalibrierung vor 3D-Bestaetigung (TODO-48); nur fuer Koerper mit einheitlichem
  //   Profil (IHasRepresentativeSection), sonst bricht der Start ab.
  // MaxCells2D/MaxCells3D: hier hoert die Kalibrierung auf zu verfeinern (Rechenzeit-Deckel).
  "MeshCalibration": {
    "Mode": "Auto",
    "Tolerance": 0.05,
    "Use2DPrecalibration": false,
    "AbsoluteTolerances": {},
    "MaxCells2D": 2000000,
    "MaxCells3D": 3000000
  },

  // --- Verifikation des Champions (TODO-43) ---
  // Mode: "Off" | "Final" (nur der Champion) | "FinalTopN" (Standard: die TopN besten) | "EachIteration"
  // TopN: Anzahl der besten Varianten bei "FinalTopN".
  // RefinementSteps: Verfeinerungsstufen gegenueber dem wirksamen Faktor (÷ √2 je Stufe).
  // Tolerance: relative Abweichung, ab der laut vor Netzabhaengigkeit gewarnt wird (0.05 = 5 %).
  "ChampionVerification": {
    "Mode": "FinalTopN",
    "TopN": 3,
    "RefinementSteps": 1,
    "Tolerance": 0.05
  }
}
