{
  // MyProject2D -- Project Settings. Plain-text reference: src/projects/BEDIENHANDBUCH.md
  //
  // The project name comes from the folder name only, never from this file.
  // Anything omitted here falls back to MyProject2DProject.CreateDefaults(); both are kept in sync.

  // --- Initial parameter values (mm); names form the contract with MyProject2DGeometryGenerator ---
  "BaseParameters": {
    "Chord": 50.0,
    "Thickness": 6.0
  },

  // --- Initial step size per parameter (rule of thumb: ~1/10 of range) ---
  "MaxDeviations": {
    "Chord": 5.0,
    "Thickness": 0.6
  },

  // --- Hard bounds; the optimizer never leaves this box ---
  "ParameterBounds": {
    "Chord": { "Min": 20.0, "Max": 100.0 },
    "Thickness": { "Min": 2.0, "Max": 25.0 }
  },

  // --- Optimization targets for the fitness formula (empty: template minimizes drag only) ---
  "OptimizationTargets": {},

  // --- Length parameters (scaled by RubberBandScaler) ---
  "DimensionalParameters": [ "Chord", "Thickness" ]
}
