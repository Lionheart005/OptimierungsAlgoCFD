{
  // MyProject -- Gmsh Mesher. Plain-text reference: src/projects/BEDIENHANDBUCH.md
  //
  // Lists every key with its code default (Solvers/Cfd/GmshMesherOptions.cs).
  // In a real project, keep only overrides. GmshCores and GmshPath live in ../simulation.json.
  // Machine-specific overrides belong in gmsh.local.json.

  // --- Wind tunnel in mm ("Box" via TunnelSize*, "Cylinder" via TunnelDiameter/-Length/-Segments) ---
  // Keep the tunnel much larger than the model (rule of thumb: >= 10 L wake downstream).
  "TunnelShape": "Box",
  "TunnelSizeX": 1000.0,
  "TunnelSizeY": 300.0,
  "TunnelSizeZ": 300.0,
  "TunnelCenterX": 200.0,
  "TunnelCenterY": 0.0,
  "TunnelCenterZ": 0.0,
  "TunnelDiameter": 300.0,
  "TunnelLength": 1000.0,
  "TunnelSegments": 64,

  // --- Physical domain guarantees (automatic outward expansion, decoupled from scaleFactor) ---
  // At least 5 L upstream, 15 L downstream, 5 W/H lateral, and max 0.3% blockage (<= 0 disables blockage expansion).
  "TunnelMinUpstreamFactor": 5.0,
  "TunnelMinDownstreamFactor": 15.0,
  "TunnelMinLateralFactor": 5.0,
  "TunnelMaxBlockagePercent": 0.3,

  // --- Distance field cell sizes (mm): SizeMin up to DistMin from wall, SizeMax beyond DistMax ---
  "BoundaryLayerSizeMin": 1.2,
  "BoundaryLayerSizeMax": 120.0,
  "BoundaryLayerDistMin": 3.0,
  "BoundaryLayerDistMax": 40.0,

  // --- Wake refinement boxes ---
  // WakeCellSize / DetailBoxCellSize in mm at level 1.0; 0 = automatic.
  "WakeRefinement": true,
  "WakeLengthFactor": 2.0,
  "WakeWidthFactor": 0.5,
  "WakeCellSize": 0.0,
  "DetailBox": true,
  "DetailBoxLengthFactor": 1.5,
  "DetailBoxWidthFactor": 0.25,
  "DetailBoxMinHeightLengthFactor": 0.15,
  "DetailBoxCellSize": 0.0,

  // --- Boundary layer ---
  // "Prism": prism layers, y+ ~ 1.5 (recommended default for voxel bodies).
  // "Threshold": y+ ~ 30-70, coarse; fails MeshCalibration.Mode = "Auto" if TargetYPlus x YPlusWarnFactor < 30.
  // "Hexa": smooth bodies without sharp edges only.
  // IMPORTANT: TargetYPlus sets the real first cell height y1 and MUST match solvers/su2.json.
  // BoundaryLayerLayers = 0 -> automatic; SurfaceCellSize = 0 -> BoundaryLayerSizeMin.
  "BoundaryLayerMode": "Prism",
  "TargetYPlus": 1.5,
  "BoundaryLayerMinLayers": 4,
  "BoundaryLayerGrowthRate": 1.28,
  "BoundaryLayerLayers": 0,
  "BoundaryLayerCoverage": 1.0,
  "SurfaceCellSize": 0.0,

  // --- Surface remeshing ---
  "MeshSizeFromCurvature": true,
  "CurvatureElements": 20,
  "CurvatureMinSizeFactor": 0.5,
  "ClassifyAngleDeg": 40.0
}
