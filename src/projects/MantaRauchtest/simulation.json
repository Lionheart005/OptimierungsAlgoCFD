{
  // ===================================================================
  //  MantaRauchtest -- Framework-Einstellungen dieses Projekts
  // ===================================================================
  //
  // Diese Datei ist das AUFGERAEUMTE Gegenstueck zur Vorlage: dort steht jeder
  // Schluessel als Nachschlagewerk, hier nur noch, was vom Code-Standard aus
  // Core/Models/SimulationConfig.cs ABWEICHT. Alles andere kommt aus Schicht 1.
  //
  // Genau das ist der Sinn der Schichten -- und dieser Lauf prueft es mit:
  // MachNumber, Su2MaxIterations, CauchyTolerance, MpiCores, das Verfahren und
  // saemtliche Algorithmus-Zahlen stehen NICHT hier und muessen trotzdem
  // dieselben sein wie bei MantaAuv. Gegenpruefen ohne Server:
  //
  //     dotnet run --project src\Automatisierung_v2 --no-build -- MantaRauchtest --print-config
  //
  // Ein unbekannter Schluessel bricht den Start ab (TODO-22).

  // --- Pfade zu externer Software ---
  //
  // Wie bei MantaAuv ABSOLUT, aus demselben Grund: der Hochschulserver (BIC_12)
  // findet SU2, Gmsh und mpirun nicht ueber den PATH. Bei "ssh host befehl"
  // startet bash nicht-interaktiv und Ubuntus ~/.bashrc steigt sofort wieder aus,
  // deshalb greift dort nichts aus conda init.
  //
  // Der Code-Standard ist und bleibt PATH-relativ ("mpirun", "SU2_CFD", "gmsh").
  // Auf einem Rechner, der die Programme regulaer installiert hat, diese drei
  // Zeilen loeschen. Welche Variante greift, sagt `sim.ps1 doctor` VOR dem Lauf.
  "MpiRunPath": "/home/lpleissner/miniconda/bin/mpirun",
  "Su2Path": "/home/lpleissner/software/bin/SU2_CFD",
  "GmshPath": "/home/lpleissner/software/gmsh-4.11.1-Linux64/bin/gmsh",

  // --- Laufumfang: DAS ist der Unterschied zu MantaAuv ---
  //
  // 2 Iterationen x 2 Varianten = 4 gerechnete Varianten, plus eine
  // Kontrollrechnung des Bouncers je Iteration (Variante 99) = 6 SU2-Laeufe.
  // MantaAuv steht auf 10 x 10 = 100 (+10). Ein Rauchtest soll die Frage
  // "laeuft die Kette durch" in Minuten beantworten, nicht ueber Nacht.
  //
  // Achtung beim Deuten der Ergebnisse: mit 4 Varianten OPTIMIERT hier nichts.
  // Der RSM braucht fuer fuenf Parameter 23 gelungene Simulationen, bevor sein
  // Ersatzmodell greift -- solange wuerfelt er gleichverteilt und schreibt
  // "Benoetige noch N Basis-Simulationen (DoE)" ins Log. Das ist erwartet.
  "MaxIterations": 2,
  "VariantsPerIteration": 2
}
